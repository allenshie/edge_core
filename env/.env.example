# Shared baseline template for edge_core runtime env files.
# Copy one of the camera-specific examples to env/.env.camXX before running.

EDGE_CAMERA_ID=camXX
EDGE_LOG_LEVEL=INFO
MONITOR_ENDPOINT=http://localhost:9400
EDGE_MONITOR_SERVICE_NAME=edge-camXX

EDGE_POLL_INTERVAL=5
EDGE_RETRY_BACKOFF=5
EDGE_RESOURCE_ROOT=.
EDGE_SCHEDULE_PATH=./schedules/schedule.json
EDGE_MODELS_CONFIG=./configs/models.yaml

EDGE_INGEST_MODE=rtsp
EDGE_RTSP_URL=rtsp://example.local/camXX
EDGE_RTSP_DROP_FRAMES=2
EDGE_RTSP_RECONNECT=1
EDGE_RTSP_FPS=15
EDGE_RTSP_WIDTH=
EDGE_RTSP_HEIGHT=

EDGE_FILE_PATH=./data/samples/example_camXX.mp4
EDGE_FILE_LOOP=1
EDGE_FILE_FPS=15
EDGE_FILE_DROP_FRAMES=0

EDGE_CAMERA_DEVICE=0
EDGE_CAMERA_FPS=
EDGE_CAMERA_WIDTH=
EDGE_CAMERA_HEIGHT=
EDGE_CAMERA_DROP_FRAMES=0

EDGE_MODEL_NAME=yolo11n
EDGE_MODEL_PATH=./weights/example_model.pt
EDGE_MODEL_DEVICE=cpu
EDGE_CONF_THRESHOLD=0.4
EDGE_TRACKER_CONFIG=trackers/bytetrack.yaml

EDGE_MODE_DEFAULT=working_stage_1
EDGE_MODE_STRATEGY=external

EDGE_MQTT_ENABLED=0
EDGE_MQTT_HOST=localhost
EDGE_MQTT_PORT=1883
EDGE_MQTT_QOS=1
EDGE_MQTT_AUTH_ENABLED=0
EDGE_MQTT_USERNAME=
EDGE_MQTT_PASSWORD=

EDGE_APP_INBOUND_BACKEND=mqtt
EDGE_PHASE_ENABLED=1
EDGE_PHASE_CHANNEL=integration/phase
EDGE_PHASE_RESOURCE_NAME=edge_mode
EDGE_EVENTS_BACKEND=http
EDGE_EVENTS_CHANNEL=/edge/events
EDGE_MATCHING_RESULT_ENABLED=0
EDGE_MATCHING_RESULT_CHANNEL=integration/matching
EDGE_MATCHING_RESULT_RESOURCE_NAME=matching_result_snapshot
EDGE_HTTP_LISTEN_HOST=0.0.0.0
EDGE_HTTP_LISTEN_PORT=9000

EDGE_VISUAL_SHOW_TRACK_INFO=0
EDGE_VISUAL_SHOW_SCORE_INFO=0
EDGE_VISUAL_DETECTION_COLOR=0,255,0

EDGE_STREAMING_ENABLED=false
EDGE_STREAMING_URL=rtmp://127.0.0.1:1935/live/camXX
EDGE_STREAMING_STRATEGY=cpu
EDGE_STREAMING_FPS=
EDGE_STREAMING_QUEUE_SIZE=30
EDGE_STREAMING_IDLE_TIMEOUT=3
EDGE_STREAMING_RESTART_BACKOFF=1
EDGE_STREAMING_OUT_WIDTH=1280
EDGE_STREAMING_OUT_HEIGHT=720
EDGE_STREAMING_SHM_MB=30

EDGE_STREAMING_RECORD_ENABLED=0
EDGE_STREAMING_RECORD_OUTPUT_DIR=./recordings
EDGE_STREAMING_RECORD_FILENAME_TEMPLATE={camera_id}_{phase}_{start_dt:%Y%m%d_%H%M%S}.mp4

INTEGRATION_API_BASE=http://localhost:9000
INTEGRATION_API_TIMEOUT=5

EDGE_HEALTH_SERVER_ENABLED=0
EDGE_HEALTH_SERVER_HOST=0.0.0.0
EDGE_HEALTH_SERVER_PORT=8081
EDGE_HEALTH_REPORT_INTERVAL_SEC=5
EDGE_HEALTH_STALE_THRESHOLD_SEC=5
EDGE_HEALTH_LIVENESS_TIMEOUT_SECONDS=30
EDGE_HEALTH_READINESS_TIMEOUT_SECONDS=30
EDGE_HEALTH_STARTUP_GRACE_SECONDS=10
